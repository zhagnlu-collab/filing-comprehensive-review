{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-manifest.schema.json",
  "title": "Review Manifest",
  "type": "object",
  "required": [
    "review_id",
    "task_type",
    "depth",
    "created_at",
    "scope",
    "coverage"
  ],
  "additionalProperties": true,
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^FR-[0-9]{8}-[0-9]{3,}$"
    },
    "task_type": {
      "enum": [
        "initial",
        "quick",
        "continuation",
        "special"
      ]
    },
    "depth": {
      "enum": [
        "programmatic",
        "full"
      ]
    },
    "review_position": {
      "enum": [
        "independent",
        "project_team",
        "intermediary"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "documents",
        "report_periods",
        "data_cutoff"
      ],
      "additionalProperties": true,
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "role",
              "version"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "primary",
                  "comparison",
                  "working_paper",
                  "prior_version",
                  "external_source",
                  "context_only"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "modified_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "report_periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_access_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "markup_convention": {
          "enum": [
            "kai_bold",
            "track_changes",
            "none"
          ]
        },
        "extension_review": {
          "type": "boolean"
        },
        "working_papers_available": {
          "type": "boolean"
        },
        "external_check": {
          "type": "boolean"
        },
        "prior_findings_available": {
          "type": "boolean"
        },
        "authority_baseline": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "data_type",
                  "source_ref"
                ],
                "additionalProperties": true,
                "properties": {
                  "data_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "旧版自由文本格式（已弃用）：仅为兼容历史项目 manifest 而接受，校验脚本会逐条发出迁移警告；字符串条目不参与权威来源挂载核对，应迁移为 {data_type, source_ref, note} 对象格式"
              }
            ]
          }
        },
        "not_in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "category",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "item_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "NOT_RUN",
              "UNVERIFIABLE",
              "NOT_IN_SCOPE"
            ]
          },
          "reason": {
            "type": "string"
          },
          "checked_at": {
            "type": "string"
          },
          "checked_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hit_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "confirmed_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "skipped_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "elapsed_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
