{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Review Finding",
  "type": "object",
  "required": [
    "id", "impact", "evidence_status", "finding_type", "title", "description",
    "document_id", "location", "original_text", "recommendation", "evidence_ids",
    "coverage_status", "review_status"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^FND-[0-9]{4,}$"},
    "impact": {"enum": ["A", "B", "C"]},
    "evidence_status": {"enum": ["CONFIRMED", "CANDIDATE", "PASS", "UNVERIFIABLE", "NOT_IN_SCOPE"]},
    "finding_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "original_text": {"type": "string", "minLength": 1},
    "expected_value": {"type": ["string", "number", "null"]},
    "actual_value": {"type": ["string", "number", "null"]},
    "difference": {"type": ["string", "number", "null"]},
    "formula_or_evidence": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{4,}$"}},
    "counter_arguments": {"type": "array", "items": {"type": "string"}},
    "root_cause": {"type": ["string", "null"]},
    "recommendation": {"type": "string", "minLength": 1},
    "related_locations": {"type": "array", "items": {"type": "string"}},
    "coverage_status": {"enum": ["COMPLETE", "PARTIAL", "NOT_RUN", "UNVERIFIABLE", "NOT_IN_SCOPE"]},
    "review_status": {"enum": ["OPEN", "FIXED", "PARTIAL", "NOT_FIXED", "NOT_APPLICABLE", "REGRESSION"]},
    "review_note": {"type": "string"},
    "unverifiable_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_status": {"const": "CONFIRMED"}},
        "required": ["evidence_status"]
      },
      "then": {
        "properties": {"evidence_ids": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {
          "impact": {"const": "A"},
          "evidence_status": {"const": "CONFIRMED"}
        },
        "required": ["impact", "evidence_status"]
      },
      "then": {
        "required": ["counter_arguments"],
        "properties": {"counter_arguments": {"minItems": 3}}
      }
    },
    {
      "if": {
        "properties": {"evidence_status": {"const": "UNVERIFIABLE"}},
        "required": ["evidence_status"]
      },
      "then": {
        "required": ["unverifiable_reason"],
        "properties": {"unverifiable_reason": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
